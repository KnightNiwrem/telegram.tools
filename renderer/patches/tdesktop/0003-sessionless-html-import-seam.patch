+[[nodiscard]] bool BindImportedMediaSource(
+		ImportContext &context,
+		RichPage::Block &media,
+		const QString &source) {
+	const auto index = int(context.localMediaPaths.size())
+		+ int(context.mediaSources.size());
+	if (!context.bindMediaSources
+		|| source.isEmpty()
+		|| index >= kImportedMediaPlaceholderLimit) {
+		return false;
+	}
+	const auto placeholder = ImportedMediaPlaceholderId(index);
+	context.mediaSources.push_back({
+		.id = placeholder,
+		.source = source,
+	});
+	if (media.kind == RichPage::BlockKind::Photo) {
+		media.photoId = placeholder;
+	} else {
+		media.documentId = placeholder;
+	}
+	return true;
+}
