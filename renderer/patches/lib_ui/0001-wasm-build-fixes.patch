From: telegram.tools rich-message renderer
Subject: [PATCH] WebAssembly build fixes for lib_ui

- QAccessible::Attribute::Orientation guarded for Qt < 6.10 (dev-host).
- emoji_config: sprite-cache SHA-256 via QCryptographicHash (no OpenSSL).
- delayed_activation: XCB focus dance excluded (no X11 in a browser).
- spoiler_mess: default masks generated inline under Emscripten -
  waiting on work queued behind the wait on the only thread would
  deadlock.
---
diff --git a/ui/accessible/ui_accessible_widget.cpp b/ui/accessible/ui_accessible_widget.cpp
index aa538f7..7e09ad4 100644
--- a/ui/accessible/ui_accessible_widget.cpp
+++ b/ui/accessible/ui_accessible_widget.cpp
@@ -360,13 +360,16 @@ bool Widget::clear() {
 
 QList<QAccessible::Attribute> Widget::attributeKeys() const {
 	auto result = QList<QAccessible::Attribute>();
+#if QT_VERSION >= QT_VERSION_CHECK(6, 10, 0)
 	if (rp()->accessibilityOrientation().has_value()) {
 		result.append(QAccessible::Attribute::Orientation);
 	}
+#endif // Qt >= 6.10
 	return result;
 }
 
 QVariant Widget::attributeValue(QAccessible::Attribute key) const {
+#if QT_VERSION >= QT_VERSION_CHECK(6, 10, 0)
 	if (key == QAccessible::Attribute::Orientation) {
 		if (const auto orientation = rp()->accessibilityOrientation()) {
 			// Plain int by design: the UIA bridge reads this back with
@@ -375,6 +378,7 @@ QVariant Widget::attributeValue(QAccessible::Attribute key) const {
 			return int(*orientation);
 		}
 	}
+#endif // Qt >= 6.10
 	return QVariant();
 }
 
