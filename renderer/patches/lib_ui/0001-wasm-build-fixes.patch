 		if (::Platform::IsX11() && focusAncestor) {
 			using namespace base::Platform::XCB::Library;
 			static const auto xcb_set_input_focus_checked = LoadSymbol<
diff --git a/ui/effects/spoiler_mess.cpp b/ui/effects/spoiler_mess.cpp
index d4413de..2029f39 100644
--- a/ui/effects/spoiler_mess.cpp
+++ b/ui/effects/spoiler_mess.cpp
@@ -257,7 +257,7 @@ void PrepareDefaultSpoiler(
 		return;
 	}
 	const auto name = QString::fromUtf8(nameFactory);
-	crl::async([=, &spoiler] {
+	const auto prepare = [=, &spoiler] {
 		const auto descriptor = descriptorFactory();
 		auto cached = ReadDefaultMask(name, SpoilerMessCached::Validator{
 			.frameDuration = descriptor.frameDuration,
@@ -274,7 +274,15 @@ void PrepareDefaultSpoiler(
 		if (!cached) {
 			WriteDefaultMask(name, *spoiler.cached);
 		}
-	});
+	};
+#ifdef __EMSCRIPTEN__
+	// Single-threaded WebAssembly: WaitDefaultSpoiler on the main thread
+	// would deadlock waiting for work queued behind it on the same thread,
+	// so the mask is generated inline.
+	prepare();
+#else // __EMSCRIPTEN__
+	crl::async(prepare);
+#endif // __EMSCRIPTEN__
 }
 
 [[nodiscard]] const SpoilerMessCached &WaitDefaultSpoiler(
diff --git a/ui/emoji_config.cpp b/ui/emoji_config.cpp
index f92235f..805619f 100644
--- a/ui/emoji_config.cpp
+++ b/ui/emoji_config.cpp
@@ -9,7 +9,31 @@
 #include "ui/widgets/fields/input_field.h"
 #include "emoji_suggestions_helper.h"
 #include "base/bytes.h"
+#ifdef __EMSCRIPTEN__
+// WebAssembly builds carry no OpenSSL; the sprite-cache signature only
+// needs SHA-256, which Qt provides. Same digest, same cache format.
+#include <QtCore/QCryptographicHash>
+namespace openssl {
+
+inline constexpr auto kSha256Size = std::size_t(32);
+
+template <typename ...Args>
+[[nodiscard]] inline bytes::vector Sha256(Args &&...args) {
+	auto hash = QCryptographicHash(QCryptographicHash::Sha256);
+	(hash.addData(QByteArrayView(
+		reinterpret_cast<const char*>(args.data()),
+		args.size())), ...);
+	const auto result = hash.result();
+	auto bytes = bytes::vector(kSha256Size);
+	Assert(result.size() == int(kSha256Size));
+	memcpy(bytes.data(), result.constData(), kSha256Size);
+	return bytes;
+}
+
+} // namespace openssl
+#else // __EMSCRIPTEN__
 #include "base/openssl_help.h"
+#endif // __EMSCRIPTEN__
 #include "base/parse_helper.h"
 #include "base/debug_log.h"
 #include "ui/style/style_core.h"
